diff --git a/apps/slides/src/renderer/components/CaptionBar.tsx b/apps/slides/src/renderer/components/CaptionBar.tsx
new file mode 100644
index 0000000..99f5b4f
--- /dev/null
+++ b/apps/slides/src/renderer/components/CaptionBar.tsx
@@ -0,0 +1,129 @@
+/**
+ * Live translated caption band for the slideshow (worship-captions add-on).
+ *
+ * Connects to a caption hub on this machine (default ws://localhost:8765, allowed by the
+ * renderer CSP's `connect-src ws://localhost:*`) and draws the latest caption lines over the
+ * bottom of the show. The band hides itself after a few seconds without new captions, so
+ * songs and silence leave the slide uncovered. If no hub is running nothing is shown and the
+ * show behaves exactly as before; the component keeps retrying quietly in the background.
+ *
+ * Hub messages (JSON):
+ *   { "type": "caption", "lines": [{ "lang": "en", "text": "..." }, { "lang": "th", "text": "..." }] }
+ *   { "type": "clear" }
+ */
+import React, { useEffect, useRef, useState } from 'react'
+
+interface CaptionLine {
+  lang: string
+  text: string
+}
+
+const DEFAULT_URL = 'ws://localhost:8765'
+const HIDE_AFTER_MS = 8000
+const RETRY_MS = 3000
+
+function hubUrl(): string {
+  try {
+    return window.localStorage.getItem('worshipCaptions.url') || DEFAULT_URL
+  } catch {
+    return DEFAULT_URL
+  }
+}
+
+export function CaptionBar(): React.ReactElement | null {
+  const [lines, setLines] = useState<CaptionLine[]>([])
+  const [visible, setVisible] = useState(false)
+  const hideTimer = useRef<number | undefined>(undefined)
+
+  useEffect(() => {
+    let ws: WebSocket | null = null
+    let retry: number | undefined
+    let closed = false
+
+    const show = (next: CaptionLine[]): void => {
+      setLines(next)
+      setVisible(true)
+      window.clearTimeout(hideTimer.current)
+      hideTimer.current = window.setTimeout(() => setVisible(false), HIDE_AFTER_MS)
+    }
+
+    const connect = (): void => {
+      if (closed) return
+      try {
+        ws = new WebSocket(hubUrl())
+      } catch {
+        retry = window.setTimeout(connect, RETRY_MS)
+        return
+      }
+      ws.onmessage = (ev) => {
+        let msg: { type?: string; lines?: CaptionLine[] }
+        try {
+          msg = JSON.parse(String(ev.data))
+        } catch {
+          return
+        }
+        if (msg.type === 'caption' && Array.isArray(msg.lines)) {
+          show(msg.lines.filter((l) => l && typeof l.text === 'string' && l.text.trim()))
+        } else if (msg.type === 'clear') {
+          window.clearTimeout(hideTimer.current)
+          setVisible(false)
+        }
+      }
+      ws.onclose = () => {
+        ws = null
+        if (!closed) retry = window.setTimeout(connect, RETRY_MS)
+      }
+    }
+
+    connect()
+    return () => {
+      closed = true
+      window.clearTimeout(retry)
+      window.clearTimeout(hideTimer.current)
+      ws?.close()
+    }
+  }, [])
+
+  if (lines.length === 0) return null
+
+  return (
+    <div
+      aria-live="polite"
+      style={{
+        position: 'absolute',
+        left: 0,
+        right: 0,
+        bottom: 0,
+        padding: '1.4vh 4vw 2.2vh',
+        background: 'rgba(0, 0, 0, 0.72)',
+        opacity: visible ? 1 : 0,
+        transition: 'opacity 600ms ease',
+        pointerEvents: 'none',
+        zIndex: 10,
+        lineHeight: 1.3,
+        textAlign: 'center',
+        fontFamily:
+          '-apple-system, BlinkMacSystemFont, "Noto Sans Thai", "Thonburi", "Apple SD Gothic Neo", "PingFang SC", sans-serif'
+      }}
+    >
+      {lines.map((l, i) => (
+        <div
+          key={l.lang + i}
+          lang={l.lang}
+          style={{
+            color: i === 0 ? '#ffffff' : '#ffe08a',
+            fontSize: i === 0 ? '2.5vw' : '2.3vw',
+            fontWeight: 500,
+            marginTop: i === 0 ? 0 : '0.6vh',
+            display: '-webkit-box',
+            WebkitLineClamp: 2,
+            WebkitBoxOrient: 'vertical',
+            overflow: 'hidden'
+          }}
+        >
+          {l.text}
+        </div>
+      ))}
+    </div>
+  )
+}
